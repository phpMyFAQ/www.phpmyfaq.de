# Ensure Apache serves index.html for directories and never prefers index.txt

# Prefer index.html as the directory index
DirectoryIndex index.html

# The export ships its own 404 page (src/app/not-found.tsx); without this
# Apache would answer with its default error page instead.
ErrorDocument 404 /404.html

# Disable MultiViews (content negotiation on filename) which could pick index.txt
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Map directory requests to index.html explicitly as a safety net
<IfModule mod_rewrite.c>
  RewriteEngine On

  # The documentation of the release lines in src/data/security.ts lives on
  # Read the Docs; the development line is documented from the main branch.
  # Keep these in step with docsUrlFor() in src/lib/docs.ts (a unit test
  # checks it). scripts/serve-static.ts applies these rules too, so the e2e
  # suite exercises them.
  RewriteRule ^docs/3\.2/?$ https://phpmyfaq.readthedocs.io/en/3.2/ [R=301,L]
  RewriteRule ^docs/4\.0/?$ https://phpmyfaq.readthedocs.io/en/4.0/ [R=301,L]
  RewriteRule ^docs/4\.1/?$ https://phpmyfaq.readthedocs.io/en/4.1/ [R=301,L]
  RewriteRule ^docs/4\.2/?$ https://phpmyfaq.readthedocs.io/en/main/ [R=301,L]

  # If the request is a directory, serve its index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*/)$ $1index.html [L]

  # Map /api/news/* to /api/news/*.json (clean URLs for API)
  RewriteCond %{REQUEST_URI} ^/api/news/([^/]+)/?$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/api/news/%1.json -f
  RewriteRule ^api/news/([^/]+)/?$ /api/news/$1.json [L]
</IfModule>

# JSON API headers
<FilesMatch "\.json$">
  <IfModule mod_headers.c>
    Header set Content-Type "application/json"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</FilesMatch>

# Do NOT block index.txt; Next.js may fetch RSC flight data from it.

# Social preview card generated by src/app/opengraph-image.tsx. Next.js exports
# it without a file extension, so tell Apache what it is.
<Files "opengraph-image">
  ForceType image/png
</Files>

# Caching. Next.js puts a content hash in every file name under /_next/static,
# and Pagefind in its index chunks, so those can be cached for a year and
# marked immutable; Pagefind's loader scripts are not hashed and revalidate. Fonts and images are
# not hashed but rarely change. HTML, JSON and XML must always be revalidated so
# a deploy is picked up immediately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/# || %{REQUEST_URI} =~ m#^/pagefind/.*\.(pf_meta|pf_index|pf_fragment|pagefind)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/(fonts|images)/# || %{REQUEST_URI} =~ m#\.(woff2?|png|jpe?g|gif|webp|svg|ico)$# || %{REQUEST_URI} == '/opengraph-image'">
    Header set Cache-Control "public, max-age=2592000"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#\.(html|json|xml|txt|js|css)$# || %{REQUEST_URI} =~ m#/$#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </ElseIf>
</IfModule>
