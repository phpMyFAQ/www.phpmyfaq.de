{
  "name": "phpmyfaq-website",
  "version": "4.2.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "pnpm run generate:news-api",
    "build": "next build",
    "postbuild": "cp -f static/.htaccess out/.htaccess || true",
    "serve": "tsx scripts/serve-static.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint-staged": "lint-staged",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "fetch:versions": "tsx scripts/fetch-versions.ts",
    "fetch:downloads": "tsx scripts/fetch-downloads.ts",
    "generate:news-api": "tsx scripts/generate-news-api.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "update:data": "pnpm run fetch:versions && pnpm run fetch:downloads",
    "prepare": "husky",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.105.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}