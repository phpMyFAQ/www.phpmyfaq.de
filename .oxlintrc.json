{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "node_modules/**",
    "dist/**",
    "next-env.d.ts"
  ],
  "plugins": ["typescript", "react", "nextjs", "jsx-a11y", "vitest", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-useless-escape": "warn",
    "nextjs/no-html-link-for-pages": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "vitest/require-mock-type-parameters": "warn",
    "typescript/triple-slash-reference": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.{test,spec}.{js,jsx,ts,tsx}", "tests/**/*.{ts,tsx}"],
      "env": {
        "vitest": true
      }
    }
  ]
}
